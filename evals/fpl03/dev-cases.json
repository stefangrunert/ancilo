[
 {"id": "dev-01", "group": "valid", "description": "Kosten mit richtiger Summe", "task": "Erstelle eine Tabelle der Kosten mit den Spalten Posten und Betrag und einer Summe.",
  "file": {"name": "Kosten.xlsx", "sheets": [{"name": "2025", "rows": [["Posten", "Betrag"], ["Miete", 900], ["Strom", 80.5], ["Summe", 980.5]]}]},
  "expect": {"valid": true, "errors": [], "rationale": "alles da, Summe stimmt"}},
 {"id": "dev-02", "group": "wrong-total", "description": "Summe falsch", "task": "Kostenaufstellung mit Summe",
  "file": {"name": "Kosten.xlsx", "sheets": [{"name": "2025", "rows": [["Posten", "Betrag"], ["Miete", 900], ["Strom", 80], ["Summe", 990]]}]},
  "expect": {"valid": false, "errors": [{"area": "numbers", "place": "2025!B4"}], "rationale": "900+80=980"}},
 {"id": "dev-03", "group": "empty", "description": "leere Tabelle", "task": "Liste der Rechnungen",
  "file": {"name": "Leer.csv", "text": ""},
  "expect": {"valid": false, "errors": [{"area": "complete"}], "rationale": "nichts drin"}},
 {"id": "dev-04", "group": "header-only", "description": "nur Kopfzeile", "task": "Liste der Rechnungen mit Datum und Betrag",
  "file": {"name": "Rechnungen.csv", "text": "Datum;Betrag\n"},
  "expect": {"valid": false, "errors": [{"area": "complete"}], "rationale": "keine Zeilen"}},
 {"id": "dev-05", "group": "missing-column", "description": "verlangte Spalte fehlt", "task": "Tabelle mit den Spalten Name, E-Mail und Telefon",
  "file": {"name": "Kontakte.xlsx", "sheets": [{"name": "Kontakte", "rows": [["Name", "E-Mail"], ["Meier", "m@x.de"]]}]},
  "expect": {"valid": false, "errors": [{"area": "complete"}], "rationale": "Telefon fehlt"}},
 {"id": "dev-06", "group": "product", "description": "Menge × Preis falsch", "task": "Bestellübersicht",
  "file": {"name": "Bestellung.xlsx", "sheets": [{"name": "B", "rows": [["Artikel", "Menge", "Einzelpreis", "Gesamt"], ["Stift", 3, 1.2, 3.6], ["Block", 2, 2.5, 4.5]]}]},
  "expect": {"valid": false, "errors": [{"area": "numbers", "place": "B!D3"}], "rationale": "2 × 2,50 = 5,00"}},
 {"id": "dev-07", "group": "valid", "description": "englische Tausender", "task": "Sales table with a total",
  "file": {"name": "Sales.csv", "text": "Region,Revenue\nNorth,\"1,250\"\nSouth,\"2,500\"\nTotal,\"3,750\"\n"},
  "expect": {"valid": true, "errors": [], "rationale": "1,250 + 2,500 = 3,750 (englisch)"}},
 {"id": "dev-08", "group": "valid", "description": "Brief mit verlangten Abschnitten", "task": "Schreibe eine Kündigung mit den Abschnitten Betreff, Kündigungsdatum und Unterschrift",
  "file": {"name": "Kündigung.docx", "blocks": [{"heading": "Betreff", "level": 1}, {"paragraph": "Kündigung meines Vertrags"}, {"heading": "Kündigungsdatum", "level": 2}, {"paragraph": "zum 31.12.2026"}, {"heading": "Unterschrift", "level": 2}, {"paragraph": "Max Muster"}]},
  "expect": {"valid": true, "errors": [], "rationale": "alle Abschnitte als Überschrift"}},
 {"id": "dev-09", "group": "docx-table", "description": "Word-Tabelle mit falscher Summe", "task": "Bericht mit einer Tabelle der Ausgaben",
  "file": {"name": "Bericht.docx", "blocks": [{"heading": "Ausgaben", "level": 1}, {"table": [["Posten", "Betrag"], ["A", "10,00"], ["B", "20,00"], ["Summe", "40,00"]]}]},
  "expect": {"valid": false, "errors": [{"area": "numbers", "place": "table 1!B4"}], "rationale": "10+20=30"}},
 {"id": "dev-10", "group": "valid", "description": "Formeltext bleibt Text: nur Hinweis", "task": "Tabelle mit Summe",
  "file": {"name": "F.xlsx", "sheets": [{"name": "S", "rows": [["Posten", "Betrag"], ["A", 1], ["B", 2], ["Summe", "=SUMME(B2:B3)"]]}]},
  "expect": {"valid": true, "errors": [], "rationale": "Formeltext: Warnung, kein Fehler"}},
 {"id": "dev-11", "group": "valid", "description": "Aufgabe schließt aus", "task": "Tabelle mit Name und Betrag, ohne Summe und ohne Spalte Datum.",
  "file": {"name": "T.csv", "text": "Name;Betrag\nA;1,50\nB;2\n"},
  "expect": {"valid": true, "errors": [], "rationale": "nichts verlangt, was fehlt"}},
 {"id": "dev-12", "group": "missing-total", "description": "verlangte Summe fehlt", "task": "Liste die Ausgaben auf und bilde am Ende die Summe.",
  "file": {"name": "A.xlsx", "sheets": [{"name": "A", "rows": [["Posten", "Betrag"], ["A", 10], ["B", 20]]}]},
  "expect": {"valid": false, "errors": [{"area": "complete"}], "rationale": "keine Summenzeile"}}
]
